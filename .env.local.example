# LocalTrust Environment Variables
# Copy this file to .env.local and fill in your Supabase project credentials.
# Find these under Project Settings → API in your Supabase dashboard.

# Public: Supabase project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public: Supabase anon/public key (Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: Supabase service role key (Settings → API → service_role)
# NEVER expose this to the browser. Used for admin operations that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
