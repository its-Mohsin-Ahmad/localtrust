# LocalTrust Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit production secrets.

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (get these from your Supabase project settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key  # server-side only

# Auth
NEXT_PUBLIC_SITE_NAME=LocalTrust

# Payment (configure only after merchant credentials are obtained and tested)
# Leave these unset during development; sandbox/test mode only.
PAYMENT_GATEWAY_PROVIDER=none
PAYMENT_PUBLIC_KEY=your-payment-public-key
PAYMENT_SECRET_KEY=your-payment-secret-key  # server-side only
PAYMENT_WEBHOOK_SECRET=your-payment-webhook-secret  # server-side only

# Email (optional — configure for verification emails / notifications)
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass  # server-side only

# Registration fee (stored in paisa / minor units)
REGISTRATION_FEE_PAISSA=20000
REGISTRATION_FEE_CURRENCY=PKR
